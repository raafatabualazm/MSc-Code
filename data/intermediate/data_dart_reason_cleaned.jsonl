data_dart_reason.jsonl:307:{"filename": "solution.dart", "function": "bronKerbosch", "source": "void bronKerbosch(\n    Set<String> 
currentClique, Set<String> candidates, Set<String> processedVertices, Map<String, Set<String>> graph) {\n  if (candidates.isEmpty && 
processedVertices.isEmpty) {\n    if (currentClique.length > 2) {\n      cliques.add(List<String>.from(currentClique));\n    }\n    return;\n 
 }\n\n  // Select a pivot vertex from 'candidates' union 'processedVertices' with the maximum degree\n  Set<String> unionSet = 
Set<String>.from(candidates)..addAll(processedVertices);\n  String pivot = unionSet.reduce((s1, s2) => graph[s1]!.length > graph[s2]!.length 
? s1 : s2);\n\n\n  // 'possibles' are vertices in 'candidates' that are not neighbors of the 'pivot'\n  Set<String> possibles = 
candidates.difference(graph[pivot]!);\n\n  for (String vertex in possibles) {\n    // Create a new clique including 'vertex'\n    Set<String> 
newCliques = Set<String>.from(currentClique)..add(vertex);\n\n    // 'newCandidates' are the members of 'candidates' that are neighbors of 
'vertex'\n    Set<String> newCandidates = candidates.intersection(graph[vertex]!);\n\n    // 'newProcessedVertices' are members of 
'processedVertices' that are neighbors of 'vertex'\n    Set<String> newProcessedVertices = 
processedVertices.intersection(graph[vertex]!);\n\n    // Recursive call with the updated sets\n    bronKerbosch(newCliques, newCandidates, 
newProcessedVertices, graph);\n\n    // Move 'vertex' from 'candidates' to 'processedVertices'\n    candidates.remove(vertex);\n    
processedVertices.add(vertex);\n  }\n}", "assembly": "Dump of assembler code for function bronKerbosch:\n   0x0000000000092eac <+0>:\tpush   
