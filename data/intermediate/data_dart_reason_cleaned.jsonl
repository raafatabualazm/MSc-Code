1\n  int q = p - 1;\n  int s = 0;\n  while (q % 2 == 0) {\n    q ~/= 2;\n    s += 1;\n  }\n\n  if (s == 1) {\n    int result = 
powerModulus(n, (p + 1) ~/ 4, p);\n    return Solution(result, p - result, true);\n  }\n\n  // Find a non-square z such that (z | p) = -1\n  
int z = 2;\n  while (legendre(z, p) != p - 1) {\n    z += 1;\n  }\n\n  int c = powerModulus(z, q, p);\n  int t = powerModulus(n, q, p);\n  
