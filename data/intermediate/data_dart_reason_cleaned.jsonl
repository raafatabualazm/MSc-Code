floydWarshall(List<List<int>> weights, int numVertices) {\n  List<List<double>> dist = List.generate(\n      numVertices, (_) => 
List.filled(numVertices, double.infinity));\n\n  for (var w in weights) {\n    dist[w[0] - 1][w[1] - 1] = w[2].toDouble();\n  }\n\n  
List<List<int>> next = List.generate(\n      numVertices, (i) => List.generate(numVertices, (j) => j != i ? j + 1 : 0));\n\n  for (int k = 0; 
k < numVertices; k++) {\n    for (int i = 0; i < numVertices; i++) {\n      for (int j = 0; j < numVertices; j++) {\n        if (dist[i][k] + 
dist[k][j] < dist[i][j]) {\n          dist[i][j] = dist[i][k] + dist[k][j];\n          next[i][j] = next[i][k];\n        }\n      }\n    }\n  
