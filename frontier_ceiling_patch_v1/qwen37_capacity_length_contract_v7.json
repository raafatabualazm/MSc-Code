    "exact_free_quota_403_is_the_only_nonretryable_boundary_accepted_from_a_prior_epoch": true,
    "rate_limits_transport_errors_and_data_inspection_do_not_authorize_an_endpoint_transition": true,
    "stages": [
      {
        "name": "secondary-dated",
        "credential": "/workspace/Qwen.env",
