      "qwen3.7-max-preview",
      "qwen3.7-max"
    ],
    "temperature": 0.8,
    "top_p": 0.95,
    "request_cap_parameter": "max_completion_tokens",
    "max_tokens_absent": true,
    "requested_total_completion_cap": 24576,
    "provider_completion_tolerance": 10,
    "completion_usage_validation_cap": 24586,
    "enable_thinking": true,
    "thinking_budget": 8192,
    "required_finish_reason": "stop",
    "reasoning_tokens_required_positive_and_bounded": true,
    "reasoning_content_required_nonempty": true,
    "unsupported_24576_or_second_length": "fail_closed"
