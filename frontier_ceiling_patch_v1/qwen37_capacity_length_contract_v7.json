        "allowed_models": [
          "qwen3.7-max-2026-05-17",
          "qwen3.7-max-2026-05-20",
          "qwen3.7-max-2026-06-08",
          "qwen3.7-max-preview",
          "qwen3.7-max"
        ],
        "imports_prior_stages": [
          "secondary-dated",
          "secondary-generic"
        ]
      }
    ]
  },
  "estimation_policy": {
    "replacement_does_not_increase_global_k": true,
    "fixed_12k_metric_uses_original_or_v6_effective_outcome": true,
    "adaptive_24k_metric_replaces_each_length_outcome_with_its_same_slot_repair": true,
    "metrics_are_withheld_until_exactly_3500_global_slots_exist": true,
