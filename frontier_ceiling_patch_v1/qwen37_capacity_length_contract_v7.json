          "qwen3.7-max-2026-05-20",
          "qwen3.7-max-2026-06-08"
        ]
      },
      {
        "name": "secondary-generic",
        "credential": "/workspace/Qwen.env",
        "allowed_models": [
          "qwen3.7-max"
        ],
        "imports_prior_stage": "secondary-dated"
      },
      {
        "name": "fallback-all-five",
